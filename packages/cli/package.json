{
    "name": "@ngcompass/cli",
    "version": "0.0.1",
    "description": "Command line interface for ngcompass",
    "bin": {
        "compass": "./dist/index.js"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/bin/ngcompass.ts --format cjs,esm --dts --clean",
        "build:prod": "NODE_ENV=production tsup src/index.ts src/bin/ngcompass.ts --format cjs,esm --dts --clean --minify",
        "dev": "tsup src/index.ts src/bin/ngcompass.ts --format cjs,esm --dts --watch",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "test:ui": "vitest --ui --passWithNoTests",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "lint": "eslint src --ext .ts",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@ngcompass/common": "workspace:*",
        "@ngcompass/core": "workspace:*",
        "@ngcompass/reporters": "workspace:*",
        "@ngcompass/rules": "workspace:*",
        "chalk": "^5.0.0",
        "commander": "^11.0.0",
        "ora": "^7.0.0"
    },
    "keywords": [
        "angular",
        "analysis",
        "cli"
    ],
    "author": "ngcompass",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^25.1.0"
    }
}