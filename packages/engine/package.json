{
    "name": "@ngcompass/engine",
    "version": "0.0.1",
    "description": "Rule execution engine for ngcompass",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "build:prod": "NODE_ENV=production tsup --minify",
        "dev": "tsup --watch",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@ngcompass/common": "workspace:*",
        "@ngcompass/ast": "workspace:*",
        "@ngcompass/cache": "workspace:*",
        "@ngcompass/planner": "workspace:*",
        "lru-cache": "^11.2.5",
        "oxc-parser": "^0.112.0",
        "p-limit": "^6.1.0"
    },
    "peerDependencies": {
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@types/node": "^25.1.0"
    },
    "keywords": [
        "angular",
        "engine",
        "rules",
        "ngcompass"
    ],
    "author": "ngcompass",
    "license": "MIT"
}