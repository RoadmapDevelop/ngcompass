{
    "name": "@ngcompass/config",
    "version": "0.0.1",
    "description": "Config loading, resolution and validation for ngcompass",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "build:prod": "NODE_ENV=production tsup src/index.ts --format cjs,esm --dts --clean --minify",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@ngcompass/common": "workspace:*",
        "@ngcompass/cache": "workspace:*",
        "@ngcompass/engine": "workspace:*",
        "defu": "^6.1.4",
        "jiti": "^2.6.1",
        "lilconfig": "^3.1.3",
        "minimatch": "^10.1.1",
        "zod": "^4.3.6",
        "zod-validation-error": "^5.0.0"
    },
    "peerDependencies": {
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@types/node": "^25.1.0"
    },
    "keywords": [
        "angular",
        "config",
        "ngcompass"
    ],
    "author": "ngcompass",
    "license": "MIT"
}